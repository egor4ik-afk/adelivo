
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OPERATOR
  COURIER
  ADMIN
}

enum OrderStatus {
  NEW
  GEOCODED
  INVALID_ADDRESS
  ASSIGNED
  IN_DELIVERY
  DELIVERED
  RETURNED
  CANCELLED
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  role              Role               @default(COURIER) // Было OPERATOR  
  firstName         String?
  lastName          String?
  phone             String?            // Сюда будем обязательно сохранять телефон при входе
  lastLoginAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Настройки уведомлений
  notifyNewOrder    Boolean            @default(true)
  notifyStatus      Boolean            @default(true)
  notifyCourier     Boolean            @default(true)
  notifyAddress     Boolean            @default(true)
  notifyTime        Boolean            @default(true)
  notifyComment     Boolean            @default(true)
  notifyOpComment   Boolean            @default(true)
  notifyItems       Boolean            @default(true)

  sessions          Session[]
  authCodes         AuthCode[]
  pushSubscriptions PushSubscription[]
  routeMessages     RouteMessage[]     // 🔥 НОВОЕ: Сообщения юзера в чатах
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model AuthCode {
  id        String   @id @default(cuid())
  userId    String
  code      String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
}

// Web Push подписки браузера
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Courier {
  id          Int      @id // Внутренний ID курьера из CRM
  firstName   String?
  lastName    String?
  patronymic  String?
  fullName    String   // Склеенное ФИО для удобного поиска
  phone       String?
  email       String?
  description String?  // Примечание из CRM
  isActive    Boolean  @default(true) // Работает ли он вообще в компании

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Связи
  shifts      CourierShift[]
  payments    CourierPayment[]
  routes      Route[] // 🔥 НОВОЕ: Маршруты курьера
}

// Таблица смен (график работы курьеров)
model CourierShift {
  id        String   @id @default(cuid())
  courierId Int
  date      String   // Строка в формате "YYYY-MM-DD"
  
  courier   Courier  @relation(fields: [courierId], references: [id], onDelete: Cascade)

  // Один курьер не может иметь две разные смены в один и тот же день
  @@unique([courierId, date])
}

model CourierPayment {
  id        String   @id @default(cuid())
  courierId Int
  date      String
  
  courier   Courier  @relation(fields: [courierId], references: [id], onDelete: Cascade)
  
  @@unique([courierId, date])
}

model Order {
  id            String      @id @default(cuid())
  crmId         String      @unique
  externalId    String?
  status        OrderStatus @default(NEW)
  address       String?
  lat           Float?
  lng           Float?
  price         Float?
  courierId     Int?        
  courier       String?
  comment       String?
  opComment     String?
  items         String?
  slotFrom      String?
  slotTo        String?
  slotRaw       String?
  deliveryType  String?
  deliveryDate  String?     
  crmStatus     String?
  isInvalid     Boolean     @default(false)
  invalidReason String?
  geocoded      Boolean     @default(false)
  crmCreatedAt  DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  changedAt     DateTime?
  courierManual Boolean     @default(false)

  
  // 🔥 НОВЫЕ ПОЛЯ:
  recipientPhone String? // Телефон получателя
  routeId        String? // Привязка к маршруту
  route          Route?  @relation(fields: [routeId], references: [id], onDelete: SetNull)
  routeOrder     Int?    // Порядок в маршруте

  @@index([createdAt])
  @@index([slotFrom, slotTo])
  @@index([status])
  @@index([isInvalid])
}

model SyncState {
  id         Int      @id @default(1)
  lastSyncAt DateTime @default(now())
}

// Лог уведомлений
model NotificationLog {
  id        String   @id @default(cuid())
  type      String   // "order.new" | "order.updated" | "address.invalid"
  channel   String   // "push" | "email"
  payload   String   // JSON строка
  success   Boolean
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type])
}

// Модель Маршрута
model Route {
  id        String   @id @default(uuid())
  name      String   // Например, "M-1234"
  link      String?  @db.Text // Ссылка на Яндекс
  date      String   // Дата "YYYY-MM-DD"
  
  courierId Int
  courier   Courier  @relation(fields: [courierId], references: [id])
  
  orders    Order[]
  messages  RouteMessage[] // Чат маршрута
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Модель сообщения в чате маршрута
model RouteMessage {
  id        String   @id @default(cuid())
  text      String   @db.Text
  
  routeId   String
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now())

  @@index([routeId])
  @@index([createdAt])
}
