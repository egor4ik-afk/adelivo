
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OPERATOR
  COURIER
  ADMIN
}

enum OrderStatus {
  NEW
  GEOCODED
  INVALID_ADDRESS
  ASSIGNED
  IN_DELIVERY
  DELIVERED
  RETURNED
  CANCELLED
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  role              Role               @default(COURIER) // Было OPERATOR  
  firstName         String?
  lastName          String?
  phone             String?            // Сюда будем обязательно сохранять телефон при входе
  lastLoginAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Настройки уведомлений
  notifyNewOrder    Boolean            @default(true)
  notifyStatus      Boolean            @default(true)
  notifyCourier     Boolean            @default(true)
  notifyAddress     Boolean            @default(true)
  notifyTime        Boolean            @default(true)
  notifyComment     Boolean            @default(true)
  notifyOpComment   Boolean            @default(true)
  notifyItems       Boolean            @default(true)

  sessions          Session[]
  authCodes         AuthCode[]
  pushSubscriptions PushSubscription[]
  conversations1    Conversation[]     @relation("ConvUser1")
  conversations2    Conversation[]     @relation("ConvUser2")
  sentMessages      Message[]          @relation("SentMessages")
  sentGlobalMessages GlobalMessage[] @relation("SentGlobalMessages")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model AuthCode {
  id        String   @id @default(cuid())
  userId    String
  code      String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
}

// Web Push подписки браузера
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Courier {
  id                Int        @id // Внутренний ID курьера из CRM
  firstName         String?
  lastName          String?
  patronymic        String?
  fullName          String   // Склеенное ФИО для удобного поиска
  phone             String?
  email             String?
  description       String?  // Примечание из CRM
  isActive          Boolean    @default(true) // Работает ли он вообще в компании
  lat               Float?   // Текущая широта (с телефона курьера)
  lng               Float?   // Текущая долгота
  locationUpdatedAt DateTime?
  homeLat           Float?   // Домашняя широта
  homeLng           Float?   // Домашняя долгота
  homeAddress       String?  // 🔥 НОВОЕ: Домашний адрес текстом
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Связи
  shifts      CourierShift[]
  payments    CourierPayment[]
  routes      Route[] // 🔥 НОВОЕ: Маршруты курьера
}

// Таблица смен (график работы курьеров)
model CourierShift {
  id        String   @id @default(cuid())
  courierId Int
  date      String   // Строка в формате "YYYY-MM-DD"
  
  courier   Courier  @relation(fields: [courierId], references: [id], onDelete: Cascade)

  // Один курьер не может иметь две разные смены в один и тот же день
  @@unique([courierId, date])
}

model CourierPayment {
  id        String   @id @default(cuid())
  courierId Int
  date      String
  
  courier   Courier  @relation(fields: [courierId], references: [id], onDelete: Cascade)
  
  @@unique([courierId, date])
}

model Order {
  id            String      @id @default(cuid())
  crmId         String      @unique
  externalId    String?
  status        OrderStatus @default(NEW)
  address       String?
  lat           Float?
  lng           Float?
  price         Float?
  courierId     Int?        
  courier       String?
  comment       String?
  opComment     String?
  items         String?
  slotFrom      String?
  slotTo        String?
  slotRaw       String?
  deliveryType  String?
  deliveryDate  String?     
  crmStatus     String?
  isInvalid     Boolean     @default(false)
  invalidReason String?
  geocoded      Boolean     @default(false)
  crmCreatedAt  DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  changedAt     DateTime?
  courierManual Boolean     @default(false)

  
  // 🔥 НОВЫЕ ПОЛЯ:
  recipientPhone String? // Телефон получателя
  routeId        String? // Привязка к маршруту
  route          Route?  @relation(fields: [routeId], references: [id], onDelete: SetNull)
  routeOrder     Int?    // Порядок в маршруте

  @@index([createdAt])
  @@index([slotFrom, slotTo])
  @@index([status])
  @@index([isInvalid])
}

model SyncState {
  id         Int      @id @default(1)
  lastSyncAt DateTime @default(now())
}

// Лог уведомлений
model NotificationLog {
  id        String   @id @default(cuid())
  type      String   // "order.new" | "order.updated" | "address.invalid"
  channel   String   // "push" | "email"
  payload   String   // JSON строка
  success   Boolean
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type])
}

// Модель Маршрута
model Route {
  id        String   @id @default(uuid())
  name      String   // Например, "M-1234"
  link      String?  @db.Text // Ссылка на Яндекс
  date      String   // Дата "YYYY-MM-DD"
  departureAdvice String?
  courierId Int
  courier   Courier  @relation(fields: [courierId], references: [id])
  
  orders    Order[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Диалог между двумя пользователями
model Conversation {
  id          String    @id @default(cuid())
  
  user1Id     String
  user2Id     String
  user1       User      @relation("ConvUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2       User      @relation("ConvUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  
  messages    Message[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([user1Id, user2Id]) // Один диалог между парой
  @@index([user1Id])
  @@index([user2Id])
}

// Сообщение в диалоге
model Message {
  id             String       @id @default(cuid())
  text           String?      @db.Text
  
  // Медиа (Yandex S3) — добавим позже
  mediaUrl       String?      @db.Text
  mediaType      String?      // "image" | "audio"
  
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  
  readAt         DateTime?    // null = непрочитано
  
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// Сообщение в Общем чате
model GlobalMessage {
  id             String       @id @default(cuid())
  text           String?      @db.Text
  
  mediaUrl       String?      @db.Text
  mediaType      String?      // "image" | "audio" | "video" | "file"
  
  senderId       String
  sender         User         @relation("SentGlobalMessages", fields: [senderId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime     @default(now())

  @@index([createdAt])
  @@index([senderId])
}
